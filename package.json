{
  "name": "claude-control-panel",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check:deps": "bun scripts/check-exact-deps.mjs",
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun run dist/index.js",
    "setup": "bash scripts/setup.sh",
    "test": "bun run check:deps && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.1.76",
    "@trpc/server": "11.8.1",
    "dotenv": "16.6.1",
    "express": "4.22.1",
    "pino": "10.1.0",
    "pino-pretty": "13.1.3",
    "ws": "8.18.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "@types/express": "5.0.6",
    "@types/node": "22.19.3",
    "@types/ws": "8.18.1",
    "@playwright/test": "1.57.0",
    "vitest": "2.1.9"
  }
}
